doctype html
html(lang='ru')
  head
    - var metaTitle = seo && seo.title ? seo.title : (title || 'AI Bot Studio')
    - var metaDescription = seo && seo.description ? seo.description : 'Интеграция AI-агентов для бизнеса: Nextbot, ElevenLabs и персональные AI-боты.'
    - var metaKeywords = seo && seo.keywords ? seo.keywords : 'интеграция ai агентов, nextbot, elevenlabs, ai боты для бизнеса'
    - var metaRobots = seo && seo.robots ? seo.robots : 'index, follow'
    - var canonicalHref = seo && seo.canonical ? seo.canonical : ''
    - var metaThemeColor = seo && seo.themeColor ? seo.themeColor : '#f3f6fb'
    - var metaOgType = seo && seo.ogType ? seo.ogType : 'website'
    - var metaOgLocale = seo && seo.locale ? seo.locale : 'ru_RU'
    - var metaOgTitle = seo && seo.ogTitle ? seo.ogTitle : metaTitle
    - var metaOgDescription = seo && seo.ogDescription ? seo.ogDescription : metaDescription
    - var metaOgUrl = seo && seo.ogUrl ? seo.ogUrl : canonicalHref
    - var metaOgSiteName = seo && seo.siteName ? seo.siteName : 'AI Bot Studio'
    - var metaOgImage = seo && seo.ogImage ? seo.ogImage : ''
    - var metaTwitterCard = seo && seo.twitterCard ? seo.twitterCard : 'summary_large_image'
    - var metaTwitterTitle = seo && seo.twitterTitle ? seo.twitterTitle : metaTitle
    - var metaTwitterDescription = seo && seo.twitterDescription ? seo.twitterDescription : metaDescription
    - var metaTwitterImage = seo && seo.twitterImage ? seo.twitterImage : metaOgImage
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= metaTitle
    meta(name='description', content=metaDescription)
    meta(name='keywords', content=metaKeywords)
    meta(name='robots', content=metaRobots)
    meta(name='googlebot', content=metaRobots)
    meta(name='theme-color', content=metaThemeColor)
    if canonicalHref
      link(rel='canonical', href=canonicalHref)
    meta(property='og:type', content=metaOgType)
    meta(property='og:locale', content=metaOgLocale)
    meta(property='og:title', content=metaOgTitle)
    meta(property='og:description', content=metaOgDescription)
    if metaOgUrl
      meta(property='og:url', content=metaOgUrl)
    meta(property='og:site_name', content=metaOgSiteName)
    if metaOgImage
      meta(property='og:image', content=metaOgImage)
      meta(property='og:image:width', content='1200')
      meta(property='og:image:height', content='630')
      meta(property='og:image:alt', content='AI Bot Studio - интеграция AI-агентов для бизнеса')
    meta(name='twitter:card', content=metaTwitterCard)
    meta(name='twitter:title', content=metaTwitterTitle)
    meta(name='twitter:description', content=metaTwitterDescription)
    if metaTwitterImage
      meta(name='twitter:image', content=metaTwitterImage)
    link(rel='stylesheet', href='/stylesheets/style.css')
    if structuredData
      script(type='application/ld+json')!= structuredData
  body
    block content
    script.
      (function () {
        var revealItems = Array.prototype.slice.call(document.querySelectorAll('.js-reveal'));
        var counterItems = Array.prototype.slice.call(document.querySelectorAll('.metric__value[data-counter]'));
        var hero = document.querySelector('.hero');
        var parallaxItems = Array.prototype.slice.call(document.querySelectorAll('.js-hero-parallax'));
        var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var supportsObserver = 'IntersectionObserver' in window;
        var canUsePointerParallax = hero && parallaxItems.length && !prefersReducedMotion && window.matchMedia('(pointer: fine)').matches;

        function showAllRevealItems() {
          revealItems.forEach(function (item) {
            item.classList.add('is-visible');
          });
        }

        if (!supportsObserver || prefersReducedMotion) {
          showAllRevealItems();
        } else if (revealItems.length) {
          var revealObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.14,
            rootMargin: '0px 0px -6% 0px'
          });

          revealItems.forEach(function (item) {
            revealObserver.observe(item);
          });
        }

        function formatCounterValue(value, suffix) {
          if (suffix === '/7') {
            return String(value) + suffix;
          }

          return String(value) + suffix;
        }

        function runCounterAnimation(el) {
          if (el.dataset.counterDone === '1') {
            return;
          }

          var target = parseFloat(el.dataset.counter || '0');
          if (!isFinite(target)) {
            return;
          }

          var prefix = el.dataset.prefix || '';
          var suffix = el.dataset.suffix || '';
          var duration = 1200;
          var startAt = performance.now();

          function tick(now) {
            var progress = Math.min((now - startAt) / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            var current = Math.round(target * eased);
            el.textContent = prefix + formatCounterValue(current, suffix);

            if (progress < 1) {
              requestAnimationFrame(tick);
            } else {
              el.textContent = prefix + formatCounterValue(target, suffix);
              el.dataset.counterDone = '1';
            }
          }

          requestAnimationFrame(tick);
        }

        if (counterItems.length) {
          if (!supportsObserver || prefersReducedMotion) {
            counterItems.forEach(runCounterAnimation);
          } else {
            var counterObserver = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  runCounterAnimation(entry.target);
                  counterObserver.unobserve(entry.target);
                }
              });
            }, {
              threshold: 0.45
            });

            counterItems.forEach(function (item) {
              counterObserver.observe(item);
            });
          }
        }

        if (!canUsePointerParallax) {
          return;
        }

        var rafId = null;
        var pointerX = 0;
        var pointerY = 0;
        var targetX = 0;
        var targetY = 0;
        var maxShift = 6;

        function applyParallax(x, y) {
          parallaxItems.forEach(function (item, index) {
            var strength = 0.55 + index * 0.25;
            item.style.setProperty('--parallax-x', (x * strength).toFixed(2) + 'px');
            item.style.setProperty('--parallax-y', (y * strength).toFixed(2) + 'px');
          });
        }

        function updateParallax() {
          pointerX += (targetX - pointerX) * 0.12;
          pointerY += (targetY - pointerY) * 0.12;
          applyParallax(pointerX, pointerY);

          if (Math.abs(targetX - pointerX) < 0.05 && Math.abs(targetY - pointerY) < 0.05) {
            rafId = null;
            return;
          }

          rafId = requestAnimationFrame(updateParallax);
        }

        function requestTick() {
          if (!rafId) {
            rafId = requestAnimationFrame(updateParallax);
          }
        }

        hero.addEventListener('pointermove', function (event) {
          var rect = hero.getBoundingClientRect();
          var x = (event.clientX - rect.left) / rect.width - 0.5;
          var y = (event.clientY - rect.top) / rect.height - 0.5;
          targetX = x * maxShift;
          targetY = y * maxShift;
          requestTick();
        });

        hero.addEventListener('pointerleave', function () {
          targetX = 0;
          targetY = 0;
          requestTick();
        });
      })();
